# LLM Configuration (OpenAI / Groq / Gemini OpenAI-compatible endpoint)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Qdrant Vector DB Configuration (Leave QDRANT_URL empty to use local on-disk Qdrant storage)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=palmmind_documents

# Redis Chat Memory Configuration
REDIS_URL=redis://localhost:6379/0

# SQL Database Configuration (PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./palmmind_metadata.db
